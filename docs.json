{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenMinetopia",
  "description": "Documentatie van OpenMinetopia, de gratis open-source Minetopia-plugin voor Paper, en van het portaal.",
  "colors": {
    "primary": "#3f6b30",
    "light": "#93d879",
    "dark": "#3f6b30"
  },
  "fonts": {
    "family": "Schibsted Grotesk"
  },
  "logo": {
    "light": "/images/brand/wordmark-light.svg",
    "dark": "/images/brand/wordmark-dark.svg",
    "href": "https://wiki.openminetopia.nl"
  },
  "favicon": "/images/brand/logo.png",
  "appearance": {
    "default": "system"
  },
  "search": {
    "prompt": "Zoek in de wiki..."
  },
  "navigation": {
    "languages": [
      {
        "language": "nl",
        "default": true,
        "tabs": [
          {
            "tab": "Plugin",
            "groups": [
              {
                "group": "Aan de slag",
                "pages": [
                  "index",
                  "plugin/installatie",
                  "plugin/configuratie"
                ]
              },
              {
                "group": "Economie",
                "pages": [
                  "plugin/modules/bankieren",
                  "plugin/modules/valuta"
                ]
              },
              {
                "group": "Spelers",
                "pages": [
                  "plugin/modules/levels",
                  "plugin/modules/fitheid",
                  "plugin/modules/prefixen",
                  "plugin/modules/kleuren",
                  "plugin/modules/chat",
                  "plugin/modules/scoreboard-actionbar"
                ]
              },
              {
                "group": "Wereld",
                "pages": [
                  "plugin/modules/plaatsen",
                  "plugin/modules/plots",
                  "plugin/modules/teleporters",
                  "plugin/modules/detectiepoortjes",
                  "plugin/modules/sloten",
                  "plugin/modules/tijd"
                ]
              },
              {
                "group": "Politie en staff",
                "pages": [
                  "plugin/modules/politie",
                  "plugin/modules/staff"
                ]
              },
              {
                "group": "Items en extra's",
                "pages": [
                  "plugin/modules/items",
                  "plugin/modules/rugzakken",
                  "plugin/modules/boeken",
                  "plugin/modules/overig"
                ]
              },
              {
                "group": "Koppelingen",
                "pages": [
                  "plugin/modules/labymod",
                  "plugin/modules/skript"
                ]
              },
              {
                "group": "Naslag",
                "pages": [
                  "plugin/commandos",
                  "plugin/placeholders",
                  "plugin/rest-api"
                ]
              }
            ]
          },
          {
            "tab": "Portaal",
            "groups": [
              {
                "group": "Portaal",
                "pages": [
                  "portaal/index",
                  "portaal/gehost",
                  "portaal/koppelen"
                ]
              }
            ]
          },
          {
            "tab": "Community",
            "groups": [
              {
                "group": "Community",
                "pages": [
                  "community/bijdragen",
                  "community/discord",
                  "community/faq"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://openminetopia.nl"
      },
      {
        "label": "Discord",
        "href": "https://discord.gg/6E3p8mPSVf"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/OpenMinetopia"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://modrinth.com/plugin/openminetopia"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://openminetopia.nl",
      "discord": "https://discord.gg/6E3p8mPSVf",
      "github": "https://github.com/OpenMinetopia"
    }
  }
}
